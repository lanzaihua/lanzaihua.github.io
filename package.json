{
  "name": "sanke-cuotiben",
  "version": "1.0.0",
  "private": true,
  "description": "四科错题本 · 高等代数 / 数学分析 / 解析几何 / 西方经济学的在线复习台",
  "scripts": {
    "build": "node build.js",
    "build:pages": "node build.js --pages",
    "build:skills": "node tools/build-skill-packs.js",
    "start": "node server.js",
    "start:lan": "node server.js --lan",
    "qa": "node tools/qa2.js",
    "shots": "node tools/shots2.js",
    "test": "node --test tests/*.test.js",
    "check": "npm test && node tools/qa-bank-strict.js --strict-difficulty && node tools/qa-site-consistency.js && node tools/check_repo_languages.js && python tools/audit_bank.py --strict-difficulty",
    "prepare:pages": "node tools/publish-pages.js",
    "verify:pages": "node tools/publish-pages.js --check",
    "qa:py": "python tools/audit_bank.py --strict-difficulty",
    "qa:responsive": "node tools/qa-responsive.js",
    "qa:formulas": "node tools/qa-formulas.js",
    "verify:build": "node tools/verify-build-consistency.js",
    "verify:skills": "node tools/verify-skill-packs.js",
    "languages": "node tools/check_repo_languages.js && python tools/audit_bank.py --strict-difficulty",
    "qa:perf": "node tools/qa-performance.js",
    "qa:a11y": "node tools/qa-a11y.js"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "linkedom": "^0.18.15",
    "playwright-core": "^1.49.1"
  }
}
